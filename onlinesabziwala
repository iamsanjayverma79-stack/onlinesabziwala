<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Verma Enterprises | Online Vegetables & Grocery</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<!-- HEADER -->
<header class="header">
    <div class="logo">Verma Enterprises</div>
    <input type="text" placeholder="Search vegetables, fruits, grocery..." class="search">
    <div class="cart">🛒 Cart (<span id="cartCount">0</span>)</div>
</header>

<!-- NAVIGATION -->
<nav class="nav">
    <a href="#">Vegetables</a>
    <a href="#">Fruits</a>
    <a href="#">Grocery</a>
    <a href="#">Daily Needs</a>
</nav>

<!-- BANNER -->
<section class="banner">
    <h1>Fresh Vegetables & Fruits Delivered at Your Doorstep</h1>
    <p>Pure • Fresh • Affordable</p>
</section>

<!-- PRODUCTS -->
<section class="products">
    <div class="product">
        <img src="https://source.unsplash.com/200x150/?tomato" alt="">
        <h3>Tomato</h3>
        <p>₹40 / kg</p>
        <button onclick="addToCart()">Add to Cart</button>
    </div>

    <div class="product">
        <img src="https://source.unsplash.com/200x150/?apple" alt="">
        <h3>Apple</h3>
        <p>₹120 / kg</p>
        <button onclick="addToCart()">Add to Cart</button>
    </div>

    <div class="product">
        <img src="https://source.unsplash.com/200x150/?rice" alt="">
        <h3>Basmati Rice</h3>
        <p>₹90 / kg</p>
        <button onclick="addToCart()">Add to Cart</button>
    </div>
</section>

<!-- FOOTER -->
<footer class="footer">
    <h3>Verma Enterprises</h3>
    <p>Hazarabagh Near Vijay Nagar Mandir, Barabanki, UP</p>
    <p>📞 94173-28848 | 923539037</p>
    <p>© 2026 Verma Enterprises</p>
</footer>

<script src="script.js"></script>
</body>
</html>
